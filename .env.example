# ── Mode ──────────────────────────────────────────────────────────────────────
# Set to "local" for local use (skips Supabase and auth)
MODE=cloud
LOCAL_WORKSPACE=~/codeforge-workspace

# ── Supabase (required only when MODE=cloud) ──────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from crypto import generate_encryption_key; print(generate_encryption_key())"
ENCRYPTION_KEY=your_32_byte_base64_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=/data/output
